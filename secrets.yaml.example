# Copy to secrets.yaml and fill in. secrets.yaml is not committed.
wifi_ssid: "YOUR_WIFI"
wifi_password: "YOUR_WIFI_PASSWORD"
# Wi-Fi of the Shelly (wivar-shelly.yaml); may be the same as above.
wifi_main_ssid: "YOUR_SHELLY_WIFI"
wifi_main_password: "YOUR_SHELLY_WIFI_PASSWORD"
timezone: "UTC"  # e.g. Europe/Berlin

# Zehnder Wivar remote: its BLE MAC (advertises as BasicRF..) and the app identity used for pairing
# (any random UUID, e.g. from `python3 -c "import uuid; print(uuid.uuid4())"`).
wivar_mac: "00:00:00:00:00:00"
wivar_app_uuid: "00000000-0000-4000-8000-000000000000"

# ESP32-C3-LCDkit (wivar-lcd.yaml). API key: generated like the Shelly's below.
wivar_lcd_api_key: "BASE64_32_BYTES"

# Shelly PM Mini Gen3 (wivar-shelly.yaml).
# API key: `python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"`
wivar_shelly_api_key: "BASE64_32_BYTES"
wivar_shelly_ap_password: "CHANGE_ME_8+_CHARS"
# Login for the Shelly's web page (port 80)
web_username: "admin"
web_password: "CHANGE_ME"
